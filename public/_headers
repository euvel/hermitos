# HERMIT-OS edge headers
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Powered-By: HERMIT-OS/1.0 (non-ergodic singular orbifold)
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/api/*
  Cache-Control: no-store

# ES modules must revalidate so a redeploy takes effect immediately
# (etag still yields 304s; this only prevents serving stale code).
/js/*
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache
